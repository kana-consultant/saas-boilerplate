DATABASE_URL=postgresql://tanstack:tanstack@127.0.0.1:5432/tanstack_start_dev
REDIS_URL=redis://127.0.0.1:6379

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=   # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# API server (used by web in prod; leave empty in dev — vite proxies to it)
# VITE_API_URL=http://localhost:3001
# Origin allowed by the api's CORS (the web app)
WEB_ORIGIN=http://localhost:3000

# Optional — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — PostHog analytics
VITE_POSTHOG_KEY=
